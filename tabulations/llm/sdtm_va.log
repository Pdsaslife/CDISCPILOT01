222        ************************** LAT, LONG, and ISONAME from mapsgfk.world_cities by averaging LAT and
222      ! LONG*******************************************;
223        proc sql;
224        	 create table world_cities as
225        	 select isoname, long, lat, isoalpha3,
226        			mean(long) as avg_long,
227        			mean(lat) as avg_lat
228        	 from mapsgfk.world_cities
229        	 group by isoname
230        	 order by isoname;
231        	quit;
232        
233        proc sort data=world_cities out=country(drop=long lat rename=(avg_long=long avg_lat=lat)) nodupkey; by isoalpha3; run;
234        
235        ************************** Create xx_DM files to create flat files
235      ! ****************************************************************************;
7                                                          The SAS System                  Wednesday, September  9, 2020 01:37:48 PM

