237        proc sql;
238        	create table dm_dm(drop=isoalpha3) as
239        	select *
240        		   ,input(scan(rfstdtc,1,'T'), yymmdd10.) as rfstdt format=date9.
241        		   ,input(scan(rfendtc,1,'T'), yymmdd10.) as rfendt format=date9.
242        	from dm  left join country on dm.country=country.isoalpha3
243        	order by usubjid;
244        	quit;
