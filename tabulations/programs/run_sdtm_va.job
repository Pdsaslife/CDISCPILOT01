<?xml version="1.0" encoding="UTF-8"?>
<job releaseVersion="1.0" description="" log="../llm" lst="../llm" mnf="../llm">
  <tasks>
    <task path="./run_sdtm_va.sas" />
  </tasks>
  <taskSpecs>
    <inputSpec path="./run_sdtm_va.sas" type="FILE" version="*" includeSubFolders="false" />
  </taskSpecs>
  <otherSpecs />
  <outputPaths />
  <outputSpec enableVersioningForNewFiles="false">
    <versionType type="MAJOR" />
  </outputSpec>
  <parameters>
    <parameter name="job_path" type="FILE" defaultValue="./sdtm_va.job" label="Job Path" />
    <parameter name="sleep_time" defaultValue="5" label="Sleep time (in seconds)" type="CHARACTER" />
    <parameter name="run_count" defaultValue="5" label="Run Count" type="CHARACTER" />
  </parameters>
</job>

